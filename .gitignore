profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the values may
#   differ from system to system.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different OS, they may wish to ignore it.
#   Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#   pdm.lock

# virtualenv
venv/
.venv/
ENV/
env/
active_env/
active_env.bat
active_env.ps1

# Spyder project settings
.spyderproject
.spyproject

# VS Code settings
.vscode/

# PyCharm settings
.idea/

# Local configuration files
.env
.env.local
.env.*.local

# Keras / TensorFlow Models (Local cached models)
# Keep the base code, but model binaries can be ignored if needed
# (leaving model.keras unignored if user wants to distribute it, but usually ignore is safe)
# model.keras
